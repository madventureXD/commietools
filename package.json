{
  "name": "commietools",
  "version": "0.1.0",
  "private": true,
  "description": "Free, local-first tools for everyone.",
  "license": "AGPL-3.0-only",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "m7:build": "node scripts/build-signer.mjs",
    "dev": "npm run dev --workspace @commietools/web",
    "build": "npm run licenses:check && npm run catalog:check && npm run build --workspaces --if-present",
    "catalog:check": "node scripts/catalog-generate.mjs check",
    "tokens:check": "node scripts/token-audit.mjs",
    "catalog:generate": "node scripts/catalog-generate.mjs generate",
    "readme:check": "node scripts/readme-scope.mjs check",
    "readme:generate": "node scripts/readme-scope.mjs generate",
    "adr:check": "node scripts/adr-audit.mjs",
    "bundle:check": "node scripts/bundle-audit.mjs",
    "viewport:check": "node scripts/viewport-audit.mjs",
    "a11y:check": "node scripts/viewport-audit.mjs a11y",
    "jsx:check": "node scripts/jsx-literal-audit.mjs",
    "glossary:check": "node scripts/glossary-audit.mjs",
    "style:check": "node scripts/style-audit.mjs",
    "format:check": "node scripts/format-audit.mjs",
    "check": "npm run policy:test && npm run licenses:check && npm run catalog:check && npm run readme:check && npm run adr:check && npm run akte:check && npm run tokens:check && npm run jsx:check && npm run glossary:check && npm run format:check && npm run lint && npm run typecheck --workspaces --if-present && npm run test --workspaces --if-present && npm run m7:check",
    "licenses:generate": "node scripts/license-audit.mjs generate",
    "licenses:check": "node scripts/license-audit.mjs check",
    "lint": "eslint .",
    "preview": "npm run preview --workspace @commietools/web",
    "akte:check": "node scripts/akte-audit.mjs",
    "beleg:sprachpakete": "node scripts/belege/sprachpakete-netzbeleg.mjs",
    "beleg:rechner-kern": "node scripts/belege/rechner-kern-groesse.mjs",
    "beleg:zusammenlegung": "node scripts/belege/zusammenlegung-beleg.mjs",
    "beleg:routing": "node scripts/belege/routing-beleg.mjs",
    "beleg:mutation-zusammenlegung": "node scripts/belege/mutation-zusammenlegung.mjs",
    "beleg:mutation-routing": "node scripts/belege/mutation-routing.mjs",
    "beleg:kartenstand": "node scripts/belege/kartenstand.mjs",
    "policy:test": "node --test scripts/rust-review-policy.test.mjs scripts/build-identity.test.mjs && node scripts/license-mutants.mjs",
    "m7:check": "node scripts/m7-eu-dss-audit.mjs",
    "verify:finish": "node scripts/verify-fertigstellung.mjs",
    "pdf:browser": "node scripts/pdf-browser-audit.mjs",
    "async:browser": "node scripts/async-browser-audit.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "postcss": "^8.5.28",
    "spdx-license-list": "^6.12.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.1"
  }
}
